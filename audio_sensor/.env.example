# Copy this file to .env and fill in real values. .env is git-ignored.
# Settings are grouped like app/config.py: each Docker service only receives
# the groups it uses (see docker-compose.yml).

# --- Shared (API, worker, Alembic) ---------------------------------------------
# Async driver (asyncpg) - the app uses SQLAlchemy's async engine. Containers
# map "localhost" here to the host automatically.
DB_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/censor
# DB_ECHO=false                 # log every SQL statement
# DB_POOL_SIZE=5                # API connection pool, plus DB_MAX_OVERFLOW under load
# DB_MAX_OVERFLOW=10
# REDIS_URL=redis://127.0.0.1:6379/0   # the containers override it
# JOB_TIME_LIMIT_MINUTES=90     # a censor job running longer is failed

# Storage: "local" (STORAGE_DIR, shared by API and worker) or "s3".
# STORAGE_BACKEND=local
# STORAGE_DIR=storage
# For S3: AWS S3, or the local SeaweedFS server
# (docker compose --profile s3 up -d s3) with these values:
# STORAGE_BACKEND=s3
# S3_BUCKET=audio-censor
# S3_ENDPOINT_URL=http://127.0.0.1:8333   # leave unset for AWS
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=dev                     # unset: boto3's usual credentials
# S3_SECRET_ACCESS_KEY=dev-secret
# S3_AUTO_CREATE_BUCKET=true               # local only; create it yourself on AWS

# --- API only ------------------------------------------------------------------
# JWT signing secret, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256             # HS256, HS384 or HS512
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# MAX_UPLOAD_MB=50
# MAX_ACTIVE_JOBS_PER_USER=3    # jobs pending/processing at once, per user
# Rate limits (per client IP for login/signup, per user for /censor). They
# count every request, so repeated Postman runs hit them: set
# RATE_LIMIT_ENABLED=false while developing.
# RATE_LIMIT_ENABLED=true
# LOGIN_RATE_LIMIT_PER_MINUTE=10
# SIGNUP_RATE_LIMIT_PER_HOUR=10
# CENSOR_RATE_LIMIT_PER_HOUR=30

# --- Worker only ---------------------------------------------------------------
# WHISPER_MODEL=small           # tiny, base, small, medium, large-v2, ...
# WHISPER_THREADS=0             # CPU threads for transcription; 0 = one per core
# WORKER_MAX_MEMORY_PER_CHILD_MB=0   # recycle a worker process above this; 0 = off
# CENSOR_WORDS=[]               # extra words as JSON, e.g. ["word1", "word2"]
# MAX_JOB_ATTEMPTS=3            # a job that keeps crashing the worker is failed
# PENDING_REQUEUE_AFTER_MINUTES=15   # re-queue a job no worker has started
