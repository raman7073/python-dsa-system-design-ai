# Virtual environment (managed by uv)
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/

# Environment variables / secrets
.env
.env.*
!.env.example

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Audio files processed at runtime (remove these lines if you commit sample audio)
*.wav
*.mp3
*.flac
*.ogg
*.m4a
