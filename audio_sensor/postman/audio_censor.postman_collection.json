    {
      "name": "Censor",
      "item": [
        {
          "name": "Censor audio (mute)",
          "request": {
            "method": "POST",
            "description": "Uploads an audio file; flagged words are replaced with silence. Returns the censored audio file.",
            "url": {
              "raw": "{{baseUrl}}/censor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "censor"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "C:\\Users\\Lenovo\\Downloads\\freesound_community-fuck-36089.mp3",
                  "description": "Audio file to censor (wav, mp3, flac, ogg, m4a, ...)."
                },
                {
                  "key": "beep",
                  "value": "false",
                  "type": "text",
                  "description": "false = silence flagged words."
                },
                {
                  "key": "padding_ms",
                  "value": "150",
                  "type": "text",
                  "description": "Extra ms muted on each side of a word (0-1000)."
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is audio', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Type')).to.match(/^audio\\//);",
                  "});",
                  "pm.test('Returned file is named *_censored.*', () => {",
                  "    pm.expect(pm.response.headers.get('Content-Disposition')).to.include('_censored');",
                  "});",
                  "pm.test('Word counts are reported', () => {",
                  "    const words = parseInt(pm.response.headers.get('X-Words-Count'), 10);",
                  "    const flagged = parseInt(pm.response.headers.get('X-Flagged-Count'), 10);",
                  "    pm.expect(words).to.be.at.least(0);",
                  "    pm.expect(flagged).to.be.within(0, words);",
                  "    console.log(`words=${words}, flagged=${flagged}`);",
                  "});",
                  "pm.test('Body is not empty', () => pm.expect(pm.response.responseSize).to.be.above(0));",
                  "",
                  "const audioId = pm.response.headers.get('X-Audio-Id');",
                  "if (audioId) pm.collectionVariables.set('audioId', audioId);",
                  "pm.test('X-Audio-Id header is set', () => pm.expect(audioId).to.match(/^[0-9a-f-]{36}$/));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Censor audio (beep)",
          "request": {
            "method": "POST",
            "description": "Same as mute, but flagged words are replaced with a 1 kHz beep.",
            "url": {
              "raw": "{{baseUrl}}/censor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "censor"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
