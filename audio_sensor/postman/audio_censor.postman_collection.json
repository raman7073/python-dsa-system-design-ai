                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Returns a bearer token', () => {",
                  "    pm.expect(body).to.have.all.keys('access_token', 'token_type', 'expires_in');",
                  "    pm.expect(body.token_type).to.eql('bearer');",
                  "    pm.expect(body.access_token.split('.')).to.have.lengthOf(3);",
                  "});",
                  "pm.test('expires_in is positive', () => pm.expect(body.expires_in).to.be.above(0));",
                  "pm.collectionVariables.set('accessToken', body.access_token);"
                ]
              }
